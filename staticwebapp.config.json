{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.sociobot.in; manifest-src 'self'; frame-ancestors 'none'; form-action 'self' https://api.sociobot.in",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache", "Content-Type": "application/manifest+json" } },
    { "route": "/demo", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/demo/*", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/offline.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-cache" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404/index.html", "statusCode": 404 }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
